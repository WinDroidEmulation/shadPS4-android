<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OpenGL ES 3.1 is the minimum for the Vulkan-backed renderer. -->
    <uses-feature android:glEsVersion="0x00030001" android:required="true" />

    <!-- Touchscreen is optional: the Big Picture UI is gamepad-first. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-feature
        android:name="android.software.vulkan"
        android:required="true" />

    <!-- Network: shadNet / miniupnpc -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Audio + Rumble -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.MODIFY_AUDIO_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Game-dump storage access.
        On Android 13+ (API 33+), READ_EXTERNAL_STORAGE is a no-op; we use
        READ_MEDIA_* for media files and MANAGE_EXTERNAL_STORAGE for
        arbitrary file access (game ISOs/PKGs the user copied to internal
        storage). The Big Picture "Game Folders" picker also reads via
        SAF/DirectoryChannel; MANAGE_EXTERNAL_STORAGE is required when
        the user keeps games under /storage/emulated/0/... outside the
        SAF picker.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
        Android 13+ media read permissions (kept for completeness; the
        primary game-loading path is via MANAGE_EXTERNAL_STORAGE, but
        declaring these avoids Permission Denial logs if the Big
        Picture file dialog ever traverses media folders).
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Foreground-service: lets the emulator keep running when the user
        backgrounds the app (e.g. downloads in shadNet). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:ignore="ForegroundServicePermission" />

    <!-- Wake lock: keep the screen on while a game is running. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:ignore="RedundantPermission" />

    <!-- Post notifications: trophy popups + friend invites use system
        notifications when the emulator window is in the background. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="false">

        <activity
            android:name=".Shadps4Activity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleTop"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Receive USB gamepad attach events. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <!--
                Open .pkg / .pfs / .eboot.bin directly from a file manager
                (e.g. Solid Explorer, FX, MiXplorer) so the user can tap a
                game dump and have shadPS4 pick it up.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.pkg" />
                <data android:pathPattern=".*\\.PKG" />
                <data android:pathPattern=".*\\.pfs" />
                <data android:pathPattern=".*\\.PFS" />
                <data android:pathPattern=".*\\.bin" />
                <data android:pathPattern=".*\\.BIN" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>
    </application>

</manifest>
