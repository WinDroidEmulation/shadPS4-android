+        c = __crc32d(c, buf8);
+        len -= sizeof(uint64_t);
+        buf += sizeof(uint64_t);
+    }
+
+    if (len >= sizeof(uint32_t)) {
+        buf4 = *((uint32_t*)buf);
+        c = __crc32w(c, buf4);
+        len -= sizeof(uint32_t);
+        buf += sizeof(uint32_t);
+    }
+
+    if (len >= sizeof(uint16_t)) {
+        buf2 = *((uint16_t*)buf);
+        c = __crc32h(c, buf2);
+        len -= sizeof(uint16_t);
+        buf += sizeof(uint16_t);
+    }
+
+    if (len) {
+        c = __crc32b(c, *buf);
+    }
