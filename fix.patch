+#define svlenu8()  svcntb_pat(SV_ALL)
+#define svlenu16() (svcntb_pat(SV_ALL) / sizeof(uint16_t))
+#define svlenu32() (svcntb_pat(SV_ALL) / sizeof(uint32_t))
+#define svlenu64() (svcntb_pat(SV_ALL) / sizeof(uint64_t))
